# 管理后台密码（生产环境必须设置；修改后需 ./deploy.sh 或 pm2 reload 重启才生效）
ADMIN_PASSWORD=change-me

# 会话密钥（建议设固定值，否则每次重启后台登录态会失效）
SESSION_SECRET=

# 后台 API 端口
PORT=4321

# 可用性监测间隔（分钟，0=关闭）
MONITOR_INTERVAL_MIN=30

# 自动采集间隔（小时，0=关闭）：从同类导航站抓新站候选进投稿队列，人工审核后收录
COLLECT_INTERVAL_HOURS=24

# 自动核验/信息回填后有变化时是否自动重建前台（0=关闭，需手动重建）
REBUILD_ON_CHANGE=1

# 前台站点 URL（用于 SEO）
SITE_URL=https://www.tokenfree.wiki
