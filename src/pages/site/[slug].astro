---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getAllSites, goUrl, ageParts, AGE_UNIT_ZH, AGE_UNIT_EN, TOOLS } from '../../utils/sites';
import modelsJson from '../../data/models.json';

export async function getStaticPaths() {
  // 失效站也生成详情页（展示失效记录），sitemap 只收录活跃站
  const sites = await getAllSites();
  return sites.map((site) => ({ params: { slug: site.id }, props: { site } }));
}

const { site } = Astro.props;
const models = modelsJson as Array<{ id: string; name: string; color: string }>;
const st = { stable: ['稳定', '#22c55e'], unstable: ['不稳定', '#f59e0b'], offline: ['已失效', '#ef4444'] }[site.status];
const host = site.url.replace(/^https?:\/\//, '').split('/')[0];
const netLabel = site.network === 'direct' ? '直连' : site.network === 'proxy' ? '需代理' : null;
const months = ageParts(site.createdAt);
const curlExample = site.apiBase ? `curl ${site.apiBase}/chat/completions \\
  -H "Authorization: Bearer sk-你的key" \\
  -H "Content-Type: application/json" \\
  -d '{"model":"gpt-4o-mini","messages":[{"role":"user","content":"hi"}]}'` : '';
// 按站点工具兼容性生成客户端配置示例（key 统一占位）
const TOOL_SNIPPETS: Record<string, { title: string; titleEn: string; code: string }> = {
  'claude-code': {
    title: 'Claude Code',
    titleEn: 'Claude Code',
    code: `export ANTHROPIC_BASE_URL=${site.apiBase?.replace(/\/v1\/?$/, '') ?? ''}
export ANTHROPIC_AUTH_TOKEN=sk-你的key`,
  },
  cursor: {
    title: 'Cursor',
    titleEn: 'Cursor',
    code: `# Settings → Models → OpenAI API Key
# OpenAI Base URL 填：
${site.apiBase ?? ''}
# API Key 填站点注册后生成的 sk- key`,
  },
  'codex-cli': {
    title: 'Codex CLI',
    titleEn: 'Codex CLI',
    code: `# ~/.codex/config.toml
model_provider = "custom"
[model_provider.custom]
base_url = "${site.apiBase ?? ''}"
wire_api = "chat"`,
  },
  cline: {
    title: 'Cline',
    titleEn: 'Cline',
    code: `# VSCode Cline 设置 → API Provider (OpenAI Compatible)
# Base URL：
${site.apiBase ?? ''}
# API Key：站点注册后生成的 sk- key`,
  },
};
const toolSnippets = (site.tools ?? [])
  .map((t) => TOOL_SNIPPETS[t])
  .filter((s) => s && site.apiBase);
---

<BaseLayout title={`${site.name} - 倍率/模型/实测 | TokenFree`} description={site.summary}>
  <Header />
  <main class="pt-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
      <a href="/" class="text-xs text-text-muted hover:text-text-secondary transition-colors" data-i18n="detail.back">← 返回列表</a>

      <div class="mt-6 flex flex-wrap items-start justify-between gap-4">
        <div>
          <div class="flex items-center gap-2.5 flex-wrap">
            <h1 class="text-2xl font-bold">{site.name}</h1>
            <span class="flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full border" style={`border-color: ${st![1]}40; color: ${st![1]}`}>
              <span class="w-1.5 h-1.5 rounded-full" style={`background: ${st![1]}`}></span>
              {st![0]}
            </span>
            {netLabel && (
              <span class={`text-xs px-2 py-0.5 rounded-full border ${site.network === 'direct' ? 'border-status-stable/30 text-status-stable' : 'border-status-unstable/30 text-status-unstable'}`}>
                {netLabel}
              </span>
            )}
          </div>
          <p class="text-sm text-text-muted mt-2 font-mono">{host}</p>
          {site.award && (
            <span class="inline-block mt-2 text-xs font-medium px-2.5 py-1 rounded-full bg-accent text-white"><span data-lang="zh">🏆 {site.award}</span>{site.awardEn && <span data-lang="en">🏆 {site.awardEn}</span>}</span>
          )}
          {months && (
            <span class="inline-block mt-2 ml-1.5 text-xs px-2.5 py-1 rounded-full bg-bg-secondary border border-border text-text-secondary">📅
              <span data-lang="zh">已收录 {months.n} {AGE_UNIT_ZH[months.unit]}</span>
              <span data-lang="en">Listed {months.n} {AGE_UNIT_EN[months.unit]}</span>
            </span>
          )}
        </div>
        {site.multiplier !== null && (
          <div class="text-center px-4 py-2 rounded-xl bg-bg-secondary border border-border">
            <p class="text-xs text-text-muted" data-i18n="detail.multiplier">倍率</p>
            <p class="text-xl font-bold font-mono">{site.multiplier}x</p>
          </div>
        )}
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-2">
        {site.url && (
          <a id="visit-btn" href={goUrl(site)} data-plain-url={`/go?url=${encodeURIComponent(site.url)}&id=${encodeURIComponent(site.id)}`}
             target="_blank" rel="noopener noreferrer nofollow"
             class="text-sm px-4 py-2 rounded-lg bg-accent hover:bg-accent-hover text-white transition-colors">
            <span data-i18n="detail.visit">访问站点 ↗</span>
          </a>
        )}
        <button id="fav-btn" class="text-sm px-4 py-2 rounded-lg border border-border text-text-secondary hover:text-accent hover:border-accent/40 transition-colors">
          <span data-i18n="detail.fav">☆ 收藏</span>
        </button>
        <a href={`/submit?site=${encodeURIComponent(site.id)}&name=${encodeURIComponent(site.name)}`} class="text-sm px-4 py-2 rounded-lg border border-border text-text-muted hover:text-status-unstable hover:border-status-unstable/40 transition-colors" title="反馈价格变动、失效等问题">
          <span data-i18n="detail.report">⚠ 报告问题</span>
        </a>
      </div>

      <!-- 实时状态（客户端拉取监测 API）+ 7 天趋势 -->
      <div id="live-status" class="mt-6 p-4 rounded-xl bg-bg-secondary border border-border text-sm text-text-secondary">
        <span class="text-text-muted" data-i18n="detail.live">实时状态：</span><span id="live-value" class="text-text-muted">加载中…</span>
        <div id="trend-wrap" class="hidden mt-3 pt-3 border-t border-border">
          <p class="text-xs text-text-muted mb-1.5">
            <span data-lang="zh">近 7 天可用率（每格约 30 分钟）</span><span data-lang="en">Last 7 days uptime (each bar ≈ 30 min)</span>
          </p>
          <div id="trend" class="flex items-end gap-[2px] h-8"></div>
        </div>
      </div>

      <div class="mt-8 space-y-6">
        <div>
          <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.intro">简介</h2>
          {site.summaryEn ? (
            <p class="text-base text-text-secondary leading-relaxed">
              <span data-lang="zh">{site.summary}</span><span data-lang="en">{site.summaryEn}</span>
            </p>
          ) : (
            <p class="text-base text-text-secondary leading-relaxed">{site.summary}</p>
          )}
        </div>
        {site.description && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.more">详细信息</h2>
            {site.descriptionEn ? (
              <p class="text-base text-text-secondary leading-relaxed whitespace-pre-line">
                <span data-lang="zh">{site.description}</span><span data-lang="en">{site.descriptionEn}</span>
              </p>
            ) : (
              <p class="text-base text-text-secondary leading-relaxed whitespace-pre-line">{site.description}</p>
            )}
          </div>
        )}
        {site.notice?.text && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2">
              <span data-lang="zh">站点公告</span><span data-lang="en">Site notice</span>
              <span class="ml-2 text-xs font-normal text-text-muted">📅 <span data-lang="zh">收录于 {site.notice.fetchedAt}</span><span data-lang="en">updated {site.notice.fetchedAt}</span></span>
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed whitespace-pre-line p-3 rounded-xl bg-bg-secondary border border-border">{site.notice.text}</p>
          </div>
        )}
        {site.bonus && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.bonus">注册赠送</h2>
            <p class="text-base text-status-stable font-medium">🎁 {site.bonusEn ? <><span data-lang="zh">{site.bonus}</span><span data-lang="en">{site.bonusEn}</span></> : site.bonus}</p>
          </div>
        )}
        {site.inviteCode && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.invite">邀请码 / 口令</h2>
            <button id="invite-btn" class="inline-flex items-center gap-2 text-sm font-mono px-3 py-1.5 rounded-lg border border-accent/30 bg-accent-muted/50 text-accent hover:bg-accent-muted transition-colors">
              🎫 {site.inviteCode} · <span data-i18n="detail.copy">复制</span>
            </button>
          </div>
        )}
        {site.topupRate && site.multiplier !== null && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.real">实际倍率</h2>
            <p class="text-sm text-text-secondary">
              <span class="font-mono font-semibold">{(site.multiplier * site.topupRate / 7.2).toFixed(2)}x</span>
              <span class="text-xs text-text-muted">（{site.multiplier}x × {site.topupRate} ÷ 7.2）</span>
            </p>
          </div>
        )}
        {site.models.length > 0 && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.models">支持模型</h2>
            <div class="flex flex-wrap gap-2">
              {site.models.map((mid) => {
                const m = models.find((x) => x.id === mid);
                if (!m) return null;
                return <span class="text-xs px-2.5 py-1 rounded-full border" style={`border-color: ${m.color}40; color: ${m.color}`}>{m.name}</span>;
              })}
            </div>
          </div>
        )}
        {(site.tools?.length ?? 0) > 0 && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.tools">工具兼容</h2>
            <div class="flex flex-wrap gap-2">
              {site.tools!.map((t) => (
                <span class="text-xs px-2.5 py-1 rounded-full border border-border text-text-secondary">{TOOLS.find((x) => x.id === t)?.name || t}</span>
              ))}
            </div>
          </div>
        )}
        {site.apiBase && curlExample && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.quickstart">快速开始</h2>
            <div class="mb-2">
              <button id="apibase-btn" class="inline-flex items-center gap-2 text-sm font-mono px-3 py-1.5 rounded-lg border border-accent/30 bg-accent-muted/50 text-accent hover:bg-accent-muted transition-colors">
                {site.apiBase} · <span data-i18n="detail.copy">复制</span>
              </button>
            </div>
            <details class="group border border-border rounded-xl bg-bg-secondary">
              <summary class="px-4 py-2.5 text-xs text-text-secondary cursor-pointer select-none hover:text-text-primary transition-colors" data-i18n="detail.curlExample">curl 调用示例</summary>
              <pre class="px-4 pb-3 text-xs leading-relaxed text-text-secondary overflow-x-auto"><code>{curlExample}</code></pre>
            </details>
            {toolSnippets.map((s) => (
              <details class="mt-2 border border-border rounded-xl bg-bg-secondary">
                <summary class="px-4 py-2.5 text-xs text-text-secondary cursor-pointer select-none hover:text-text-primary transition-colors">{s.title} <span class="text-text-muted">配置示例</span></summary>
                <pre class="px-4 pb-3 text-xs leading-relaxed text-text-secondary overflow-x-auto"><code>{s.code}</code></pre>
              </details>
            ))}
          </div>
        )}
        {site.tags.length > 0 && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.tags">标签</h2>
            <div class="flex flex-wrap gap-2">
              {site.tags.map((t) => <span class="text-xs px-2.5 py-1 rounded-full border border-dashed border-border text-text-muted">#{t}</span>)}
            </div>
          </div>
        )}
        {(site.events?.length ?? 0) > 0 && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-3" data-i18n="detail.events">体验日志</h2>
            <div class="border-l border-border ml-1 space-y-4">
              {[...site.events!].reverse().map((ev) => (
                <div class="relative pl-4">
                  <span class="absolute -left-[3.5px] top-1.5 w-1.5 h-1.5 rounded-full bg-accent/60"></span>
                  <p class="text-xs text-text-muted font-mono mb-0.5">{ev.date}</p>
                  <p class="text-base text-text-secondary leading-relaxed">{ev.text}</p>
                </div>
              ))}
            </div>
          </div>
        )}
        <div class="grid grid-cols-2 gap-3 text-xs text-text-muted border-t border-border pt-4">
          <p><span data-i18n="detail.verified">核验日期</span>：{site.verifiedAt}</p>
          <p><span data-i18n="detail.updated">更新时间</span>：{site.updatedAt}</p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
  <script>
    // 实时状态 + 收藏 + AFF 感知
    const siteId = location.pathname.split('/').pop();
    const en = localStorage.getItem('tf-lang') === 'en';
    fetch('/api/uptime')
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        const el = document.getElementById('live-value');
        if (!d || !el) return;
        const u = d[siteId];
        if (!u || !u.checks) {
          el.textContent = en ? 'No monitor data yet' : '暂无监测数据';
          return;
        }
        const pct = u.uptime24h != null ? `${Math.round(u.uptime24h * 100)}%` : '—';
        const apiPart =
          u.apiUp === true
            ? (en ? ' · API endpoint OK' : ' · API 端点正常')
            : u.apiUp === false
              ? (en ? ' · API endpoint DOWN' : ' · API 端点异常')
              : '';
        el.innerHTML = !u.up
          ? `<span style="color:#ef4444">● ${en ? 'unreachable' : '不可达'}</span> · ${en ? '24h uptime' : '24h 可用率'} ${pct}`
          : u.apiUp === false
            ? `<span style="color:#f59e0b">● ${en ? 'web up, API down' : '网页在线 · API 异常'}</span> · ${en ? '24h uptime' : '24h 可用率'} ${pct}`
            : `<span style="color:#22c55e">● ${en ? 'up' : '在线'}</span> · ${en ? 'latency' : '延迟'} ${u.latencyMs ?? '?'}ms${apiPart} · ${en ? '24h uptime' : '24h 可用率'} ${pct}`;
      })
      .catch(() => {
        const el = document.getElementById('live-value');
        if (el) el.textContent = '暂无监测数据';
      });

    // 7 天趋势条（数据量大时按相邻聚合，保证不超过 ~120 格不溢出容器）
    fetch('/api/uptime/history/' + encodeURIComponent(siteId || ''))
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        let checks = (d && d.checks) || [];
        if (checks.length < 2) return;
        if (checks.length > 120) {
          const size = Math.ceil(checks.length / 120);
          const buckets = [];
          for (let i = 0; i < checks.length; i += size) {
            const g = checks.slice(i, i + size);
            buckets.push({
              t: g[0].t,
              ok: g.filter((c) => c.ok).length > g.length / 2,
              ms: g.reduce((s, c) => s + (c.ms ?? 0), 0) / g.length,
              api: g.some((c) => c.api === false) ? false : undefined,
              n: g.length,
            });
          }
          checks = buckets;
        }
        const wrap = document.getElementById('trend-wrap');
        const box = document.getElementById('trend');
        if (!wrap || !box) return;
        for (const c of checks) {
          const bar = document.createElement('div');
          const time = new Date(c.t).toLocaleString(en ? 'en-US' : 'zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
          bar.className = 'flex-1 min-w-[2px] rounded-sm';
          bar.style.height = c.ok ? (c.ms != null && c.ms < 1500 ? '100%' : '70%') : '30%';
          bar.style.background = c.ok ? (c.api === false ? '#f59e0b' : '#22c55e') : '#ef4444';
          bar.title = `${time} · ${c.ok ? (en ? 'up' : '在线') : en ? 'down' : '不可达'}${c.ms != null ? ` ${Math.round(c.ms)}ms` : ''}${c.api === false ? (en ? ' · API down' : ' · API异常') : ''}`;
          box.appendChild(bar);
        }
        wrap.classList.remove('hidden');
      })
      .catch(() => {});

    const inviteBtn = document.getElementById('invite-btn');
    if (inviteBtn) {
      inviteBtn.onclick = () => {
        navigator.clipboard?.writeText(inviteBtn.textContent?.replace(/^🎫\s*/, '').split('·')[0].trim() || '').then(() => {
          const label = inviteBtn.querySelector('[data-i18n]');
          if (label) {
            const orig = label.textContent;
            label.textContent = localStorage.getItem('tf-lang') === 'en' ? 'Copied ✓' : '已复制 ✓';
            setTimeout(() => (label.textContent = orig), 1500);
          }
        }).catch(() => {});
      };
    }

    const apibaseBtn = document.getElementById('apibase-btn');
    if (apibaseBtn) {
      apibaseBtn.onclick = () => {
        navigator.clipboard?.writeText(apibaseBtn.textContent?.split('·')[0].trim() || '').then(() => {
          const label = apibaseBtn.querySelector('[data-i18n]');
          if (label) {
            const orig = label.textContent;
            label.textContent = localStorage.getItem('tf-lang') === 'en' ? 'Copied ✓' : '已复制 ✓';
            setTimeout(() => (label.textContent = orig), 1500);
          }
        }).catch(() => {});
      };
    }

    const favBtn = document.getElementById('fav-btn') as HTMLButtonElement | null;
    if (favBtn) {
      const renderFav = () => {
        const favs: string[] = JSON.parse(localStorage.getItem('tf-favs') || '[]');
        const on = favs.includes(siteId);
        const en = localStorage.getItem('tf-lang') === 'en';
        favBtn.textContent = on ? (en ? '★ Favorited' : '★ 已收藏') : en ? '☆ Favorite' : '☆ 收藏';
        favBtn.classList.toggle('text-accent', on);
      };
      favBtn.onclick = () => {
        const favs: string[] = JSON.parse(localStorage.getItem('tf-favs') || '[]');
        const i = favs.indexOf(siteId);
        if (i >= 0) favs.splice(i, 1);
        else favs.push(siteId);
        localStorage.setItem('tf-favs', JSON.stringify(favs));
        renderFav();
      };
      renderFav();
    }


  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: site.name + ' - TokenFree',
    description: site.summary,
    url: new URL('/site/' + site.id, Astro.site ?? 'https://www.tokenfree.wiki').href,
    datePublished: site.createdAt,
    dateModified: site.updatedAt,
    inLanguage: 'zh-CN',
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: (Astro.site ?? 'https://www.tokenfree.wiki').toString() },
        { '@type': 'ListItem', position: 2, name: '全部站点', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: site.name },
      ],
    },
  })} />
</BaseLayout>
