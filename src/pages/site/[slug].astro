---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getAllSites, goUrl, ageParts, AGE_UNIT_ZH, AGE_UNIT_EN, TOOLS } from '../../utils/sites';
import modelsJson from '../../data/models.json';

export async function getStaticPaths() {
  const sites = await getAllSites();
  return sites.map((site) => ({ params: { slug: site.id }, props: { site } }));
}

const { site } = Astro.props;
const models = modelsJson as Array<{ id: string; name: string; color: string }>;
const st = { stable: ['稳定', '#22c55e'], unstable: ['不稳定', '#f59e0b'], offline: ['已失效', '#ef4444'] }[site.status];
const host = site.url.replace(/^https?:\/\//, '').split('/')[0];
const netLabel = site.network === 'direct' ? '直连' : site.network === 'proxy' ? '需代理' : null;

// 相关站点推荐
const allSites = await getAllSites();
const related = allSites
  .filter((s) => s.id !== site.id && s.status !== 'offline')
  .map((s) => {
    const sharedModels = s.models.filter((m) => site.models.includes(m)).length;
    const sharedTags = s.tags.filter((t) => site.tags.includes(t)).length;
    return { site: s, score: sharedModels * 2 + sharedTags };
  })
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map((r) => r.site);
---

<BaseLayout title={`${site.name} - 倍率/模型/实测 | TokenFree`} description={site.summary}>
  <Header />
  <main class="pt-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
      <a href="/" class="text-xs text-text-muted hover:text-text-secondary transition-colors" data-i18n="detail.back">← 返回列表</a>

      <div class="mt-6 flex flex-wrap items-start justify-between gap-4">
        <div>
          <div class="flex items-center gap-2.5 flex-wrap">
            <h1 class="text-2xl font-bold">{site.name}</h1>
            <span class="flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full border" style={`border-color: ${st![1]}40; color: ${st![1]}`}>
              <span class="w-1.5 h-1.5 rounded-full" style={`background: ${st![1]}`}></span>
              {st![0]}
            </span>
            {netLabel && (
              <span class={`text-xs px-2 py-0.5 rounded-full border ${site.network === 'direct' ? 'border-status-stable/30 text-status-stable' : 'border-status-unstable/30 text-status-unstable'}`}>
                {netLabel}
              </span>
            )}
          </div>
          <p class="text-sm text-text-muted mt-2 font-mono">{host}</p>
          {site.award && (
            <span class="inline-block mt-2 text-xs font-medium px-2.5 py-1 rounded-full bg-accent text-white"><span data-lang="zh">🏆 {site.award}</span>{site.awardEn && <span data-lang="en">🏆 {site.awardEn}</span>}</span>
          )}
          {(() => {
            const op = ageParts(site.domainRegisteredAt);
            return op ? (
              <span
                class="inline-block mt-2 ml-1.5 text-xs px-2.5 py-1 rounded-full bg-status-stable/10 border border-status-stable/30 text-status-stable"
                title={`域名注册于 ${site.domainRegisteredAt}（注册局记录）`}
              >
                🚀 <span data-lang="zh">已运营 {op.n} {AGE_UNIT_ZH[op.unit]}</span>
                <span data-lang="en">live {op.n} {AGE_UNIT_EN[op.unit]}</span>
              </span>
            ) : null;
          })()}
        </div>
        {site.multiplier !== null && (
          <div class="text-center px-4 py-2 rounded-xl bg-bg-secondary border border-border">
            <p class="text-xs text-text-muted" data-i18n="detail.multiplier">倍率</p>
            <p class="text-xl font-bold font-mono">{site.multiplier}x</p>
          </div>
        )}
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-2">
        {site.url && (
          <a id="visit-btn" href={goUrl(site)} data-plain-url={`/go?url=${encodeURIComponent(site.url)}&id=${encodeURIComponent(site.id)}`}
             target="_blank" rel="noopener noreferrer nofollow"
             class="text-sm px-4 py-2 rounded-lg bg-accent hover:bg-accent-hover text-white transition-colors">
            <span data-i18n="detail.visit">访问站点 ↗</span>
          </a>
        )}
        <button id="fav-btn" class="text-sm px-4 py-2 rounded-lg border border-border text-text-secondary hover:text-accent hover:border-accent/40 transition-colors">
          <span data-i18n="detail.fav">☆ 收藏</span>
        </button>
        <a href={`/submit?site=${encodeURIComponent(site.id)}&name=${encodeURIComponent(site.name)}&url=${encodeURIComponent(site.url)}&summary=${encodeURIComponent(site.summary)}`} class="text-sm px-4 py-2 rounded-lg border border-border text-text-muted hover:text-status-unstable hover:border-status-unstable/40 transition-colors" title="反馈价格变动、失效等问题">
          <span data-i18n="detail.report">⚠ 报告问题</span>
        </a>
      </div>

      <div id="live-status" class="mt-6 p-4 rounded-xl bg-bg-secondary border border-border text-sm text-text-secondary">
        <span class="text-text-muted" data-i18n="detail.live">实时状态：</span><span id="live-value" class="text-text-muted">加载中…</span>
        <div id="trend-wrap" class="hidden mt-3 pt-3 border-t border-border">
          <p class="text-xs text-text-muted mb-1.5">
            <span data-lang="zh">近 7 天可用率（每格约 30 分钟）</span><span data-lang="en">Last 7 days uptime (each bar ≈ 30 min)</span>
          </p>
          <div id="trend" class="flex items-end gap-[2px] h-8"></div>
        </div>
      </div>

      <div class="mt-8 space-y-5">
        <div>
          <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.intro">简介</h2>
          {site.summaryEn ? (
            <p class="text-base text-text-secondary leading-relaxed">
              <span data-lang="zh">{site.summary}</span><span data-lang="en">{site.summaryEn}</span>
            </p>
          ) : (
            <p class="text-base text-text-secondary leading-relaxed">{site.summary}</p>
          )}
          {site.description && (
            <p class="text-sm text-text-muted mt-2 leading-relaxed whitespace-pre-line">{site.description}</p>
          )}
        </div>

        {site.bonus && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.bonus">注册赠送</h2>
            <p class="text-base text-status-stable font-medium">🎁 {site.bonusEn ? <><span data-lang="zh">{site.bonus}</span><span data-lang="en">{site.bonusEn}</span></> : site.bonus}</p>
          </div>
        )}

        {site.notice?.text && (
          <details class="group">
            <summary class="text-sm font-medium text-text-muted cursor-pointer hover:text-text-secondary transition-colors">
              <span data-lang="zh">站点公告</span><span data-lang="en">Site notice</span>
              <span class="text-xs font-normal text-text-muted ml-1">📅 {site.notice.fetchedAt}</span>
              <span class="text-xs text-text-muted ml-1 group-open:hidden">▸</span>
              <span class="text-xs text-text-muted ml-1 hidden group-open:inline">▾</span>
            </summary>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed whitespace-pre-line p-3 rounded-xl bg-bg-secondary border border-border">{site.notice.text}</p>
          </details>
        )}

        {site.models.length > 0 && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.models">支持模型</h2>
            <div class="flex flex-wrap gap-2">
              {site.models.map((mid) => {
                const m = models.find((x) => x.id === mid);
                if (!m) return null;
                return <span class="text-xs px-2.5 py-1 rounded-full border" style={`border-color: ${m.color}40; color: ${m.color}`}>{m.name}</span>;
              })}
            </div>
          </div>
        )}

        {(site.tools?.length ?? 0) > 0 && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.tools">工具兼容</h2>
            <div class="flex flex-wrap gap-2">
              {site.tools!.map((t) => (
                <span class="text-xs px-2.5 py-1 rounded-full border border-border text-text-secondary">{TOOLS.find((x) => x.id === t)?.name || t}</span>
              ))}
            </div>
          </div>
        )}

        {site.tags.length > 0 && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2" data-i18n="detail.tags">标签</h2>
            <div class="flex flex-wrap gap-2">
              {site.tags.map((t) => <span class="text-xs px-2.5 py-1 rounded-full border border-dashed border-border text-text-muted">#{t}</span>)}
            </div>
          </div>
        )}
      </div>

      {related.length > 0 && (
        <div class="mt-10 border-t border-border pt-6">
          <h2 class="text-sm font-medium text-text-muted mb-3">
            <span data-lang="zh">相关站点</span><span data-lang="en">Related sites</span>
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {related.map((r) => (
              <a
                href={`/site/${r.id}`}
                class="flex items-center gap-3 p-3 rounded-xl border border-border bg-bg-secondary hover:border-accent/40 hover:bg-accent-muted/40 transition-colors"
              >
                <span class="w-9 h-9 rounded-lg flex items-center justify-center font-semibold text-sm shrink-0" style={`background: ${models.find((m) => r.models.includes(m.id))?.color ?? '#7c5cfc'}20; color: ${models.find((m) => r.models.includes(m.id))?.color ?? '#7c5cfc'}`}>
                  {r.name.trim().charAt(0).toUpperCase()}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-medium text-text-primary truncate">{r.name}</span>
                  {r.multiplier !== null && (
                    <span class="block text-xs font-mono text-text-muted">{r.multiplier}x</span>
                  )}
                </span>
                <span class="text-xs text-text-muted shrink-0">→</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>
  <Footer />
  <script>
    import { fetchUptime } from '../../utils/clientData';
    const siteId = location.pathname.split('/').pop();
    const en = localStorage.getItem('tf-lang') === 'en';
    fetchUptime()
      .then((d) => {
        const el = document.getElementById('live-value');
        if (!d || !el) return;
        const u = (d as any)[siteId];
        if (!u || !u.checks) {
          el.textContent = en ? 'No monitor data yet' : '暂无监测数据';
          return;
        }
        const pct = u.uptime24h != null ? `${Math.round(u.uptime24h * 100)}%` : '—';
        const apiPart =
          u.apiUp === true
            ? (en ? ' · API endpoint OK' : ' · API 端点正常')
            : u.apiUp === false
              ? (en ? ' · API endpoint DOWN' : ' · API 端点异常')
              : '';
        el.innerHTML = !u.up
          ? `<span style="color:#ef4444">● ${en ? 'unreachable' : '不可达'}</span> · ${en ? '24h uptime' : '24h 可用率'} ${pct}`
          : u.apiUp === false
            ? `<span style="color:#f59e0b">● ${en ? 'web up, API down' : '网页在线 · API 异常'}</span> · ${en ? '24h uptime' : '24h 可用率'} ${pct}`
            : `<span style="color:#22c55e">● ${en ? 'up' : '在线'}</span> · ${en ? 'latency' : '延迟'} ${u.latencyMs ?? '?'}ms${apiPart} · ${en ? '24h uptime' : '24h 可用率'} ${pct}`;
      })
      .catch(() => {
        const el = document.getElementById('live-value');
        if (el) el.textContent = '暂无监测数据';
      });

    fetch('/api/uptime/history/' + encodeURIComponent(siteId || ''))
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        let checks = (d && d.checks) || [];
        if (checks.length < 2) return;
        if (checks.length > 120) {
          const size = Math.ceil(checks.length / 120);
          const buckets = [];
          for (let i = 0; i < checks.length; i += size) {
            const g = checks.slice(i, i + size);
            buckets.push({
              t: g[0].t,
              ok: g.filter((c) => c.ok).length > g.length / 2,
              ms: g.reduce((s, c) => s + (c.ms ?? 0), 0) / g.length,
              api: g.some((c) => c.api === false) ? false : undefined,
              n: g.length,
            });
          }
          checks = buckets;
        }
        const wrap = document.getElementById('trend-wrap');
        const box = document.getElementById('trend');
        if (!wrap || !box) return;
        for (const c of checks) {
          const bar = document.createElement('div');
          const time = new Date(c.t).toLocaleString(en ? 'en-US' : 'zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
          bar.className = 'flex-1 min-w-[2px] rounded-sm';
          bar.style.height = c.ok ? (c.ms != null && c.ms < 1500 ? '100%' : '70%') : '30%';
          bar.style.background = c.ok ? (c.api === false ? '#f59e0b' : '#22c55e') : '#ef4444';
          bar.title = `${time} · ${c.ok ? (en ? 'up' : '在线') : en ? 'down' : '不可达'}${c.ms != null ? ` ${Math.round(c.ms)}ms` : ''}${c.api === false ? (en ? ' · API down' : ' · API异常') : ''}`;
          box.appendChild(bar);
        }
        wrap.classList.remove('hidden');
      })
      .catch(() => {});

    const favBtn = document.getElementById('fav-btn') as HTMLButtonElement | null;
    if (favBtn) {
      const renderFav = () => {
        const favs: string[] = JSON.parse(localStorage.getItem('tf-favs') || '[]');
        const on = favs.includes(siteId);
        const en = localStorage.getItem('tf-lang') === 'en';
        favBtn.textContent = on ? (en ? '★ Favorited' : '★ 已收藏') : en ? '☆ Favorite' : '☆ 收藏';
        favBtn.classList.toggle('text-accent', on);
      };
      favBtn.onclick = () => {
        const favs: string[] = JSON.parse(localStorage.getItem('tf-favs') || '[]');
        const i = favs.indexOf(siteId);
        if (i >= 0) favs.splice(i, 1);
        else favs.push(siteId);
        localStorage.setItem('tf-favs', JSON.stringify(favs));
        renderFav();
      };
      renderFav();
    }
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: site.name + ' - TokenFree',
    description: site.summary,
    url: new URL('/site/' + site.id, Astro.site ?? 'https://www.tokenfree.wiki').href,
    datePublished: site.createdAt,
    dateModified: site.updatedAt,
    inLanguage: 'zh-CN',
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: (Astro.site ?? 'https://www.tokenfree.wiki').toString() },
        { '@type': 'ListItem', position: 2, name: '全部站点', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: site.name },
      ],
    },
  })} />
</BaseLayout>
