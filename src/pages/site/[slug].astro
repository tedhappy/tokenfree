---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getAllSites, goUrl, TOOLS } from '../../utils/sites';
import modelsJson from '../../data/models.json';

export async function getStaticPaths() {
  // 失效站也生成详情页（展示失效记录），sitemap 只收录活跃站
  const sites = await getAllSites();
  return sites.map((site) => ({ params: { slug: site.id }, props: { site } }));
}

const { site } = Astro.props;
const models = modelsJson as Array<{ id: string; name: string; color: string }>;
const st = { stable: ['稳定', '#22c55e'], unstable: ['不稳定', '#f59e0b'], offline: ['已失效', '#ef4444'] }[site.status];
const host = site.url.replace(/^https?:\/\//, '').split('/')[0];
const netLabel = site.network === 'direct' ? '国内直连' : site.network === 'proxy' ? '需代理' : null;
---

<BaseLayout title={`${site.name} - 倍率/模型/评价 | TokenFree`} description={site.summary}>
  <Header />
  <main class="pt-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
      <a href="/" class="text-xs text-text-muted hover:text-text-secondary transition-colors">← 返回列表</a>

      <div class="mt-6 flex flex-wrap items-start justify-between gap-4">
        <div>
          <div class="flex items-center gap-2.5 flex-wrap">
            <h1 class="text-2xl font-bold">{site.name}</h1>
            <span class="flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full border" style={`border-color: ${st![1]}40; color: ${st![1]}`}>
              <span class="w-1.5 h-1.5 rounded-full" style={`background: ${st![1]}`}></span>
              {st![0]}
            </span>
            {netLabel && (
              <span class={`text-xs px-2 py-0.5 rounded-full border ${site.network === 'direct' ? 'border-status-stable/30 text-status-stable' : 'border-status-unstable/30 text-status-unstable'}`}>
                {netLabel}
              </span>
            )}
          </div>
          <p class="text-sm text-text-muted mt-2 font-mono">{host}</p>
        </div>
        {site.multiplier !== null && (
          <div class="text-center px-4 py-2 rounded-xl bg-bg-secondary border border-border">
            <p class="text-[10px] text-text-muted">倍率</p>
            <p class="text-xl font-bold font-mono">{site.multiplier}x</p>
          </div>
        )}
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-2">
        {site.url && (
          <a id="visit-btn" href={goUrl(site)} data-plain-url={`/go?url=${encodeURIComponent(site.url)}&id=${encodeURIComponent(site.id)}`}
             target="_blank" rel="noopener noreferrer nofollow"
             class="text-sm px-4 py-2 rounded-lg bg-accent hover:bg-accent-hover text-white transition-colors">
            访问站点 ↗
          </a>
        )}
        <button id="fav-btn" class="text-sm px-4 py-2 rounded-lg border border-border text-text-secondary hover:text-accent hover:border-accent/40 transition-colors">
          ☆ 收藏
        </button>
      </div>

      <!-- 实时状态（客户端拉取监测 API） -->
      <div id="live-status" class="mt-6 p-4 rounded-xl bg-bg-secondary border border-border text-sm text-text-secondary">
        <span class="text-text-muted">实时状态：</span><span id="live-value" class="text-text-muted">加载中…</span>
      </div>

      <div class="mt-8 space-y-6">
        <div>
          <h2 class="text-sm font-medium text-text-muted mb-2">简介</h2>
          <p class="text-sm text-text-secondary leading-relaxed">{site.summary}</p>
        </div>
        {site.description && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2">详细信息</h2>
            <p class="text-sm text-text-secondary leading-relaxed whitespace-pre-line">{site.description}</p>
          </div>
        )}
        {site.bonus && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2">注册赠送</h2>
            <p class="text-sm text-status-stable">🎁 {site.bonus}</p>
          </div>
        )}
        {site.models.length > 0 && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2">支持模型</h2>
            <div class="flex flex-wrap gap-2">
              {site.models.map((mid) => {
                const m = models.find((x) => x.id === mid);
                if (!m) return null;
                return <span class="text-xs px-2.5 py-1 rounded-full border" style={`border-color: ${m.color}40; color: ${m.color}`}>{m.name}</span>;
              })}
            </div>
          </div>
        )}
        {(site.tools?.length ?? 0) > 0 && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2">工具兼容</h2>
            <div class="flex flex-wrap gap-2">
              {site.tools!.map((t) => (
                <span class="text-xs px-2.5 py-1 rounded-full border border-border text-text-secondary">{TOOLS.find((x) => x.id === t)?.name || t}</span>
              ))}
            </div>
          </div>
        )}
        {site.tags.length > 0 && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-2">标签</h2>
            <div class="flex flex-wrap gap-2">
              {site.tags.map((t) => <span class="text-xs px-2.5 py-1 rounded-full border border-dashed border-border text-text-muted">#{t}</span>)}
            </div>
          </div>
        )}
        {(site.events?.length ?? 0) > 0 && (
          <div>
            <h2 class="text-sm font-medium text-text-muted mb-3">体验日志</h2>
            <div class="border-l border-border ml-1 space-y-4">
              {[...site.events!].reverse().map((ev) => (
                <div class="relative pl-4">
                  <span class="absolute -left-[3.5px] top-1.5 w-1.5 h-1.5 rounded-full bg-accent/60"></span>
                  <p class="text-xs text-text-muted font-mono mb-0.5">{ev.date}</p>
                  <p class="text-sm text-text-secondary leading-relaxed">{ev.text}</p>
                </div>
              ))}
            </div>
          </div>
        )}
        <div class="grid grid-cols-2 gap-3 text-xs text-text-muted border-t border-border pt-4">
          <p>核验日期：{site.verifiedAt}</p>
          <p>更新时间：{site.updatedAt}</p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
  <script>
    // 实时状态 + 收藏 + AFF 感知
    const siteId = location.pathname.split('/').pop();
    fetch('/api/uptime')
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        const el = document.getElementById('live-value');
        if (!d || !el) return;
        const u = d[siteId];
        if (!u || !u.checks) {
          el.textContent = '暂无监测数据';
          return;
        }
        const pct = u.uptime24h != null ? `${Math.round(u.uptime24h * 100)}%` : '—';
        el.innerHTML = u.up
          ? `<span style="color:#22c55e">● 在线</span> · 延迟 ${u.latencyMs ?? '?'}ms · 24h 可用率 ${pct}`
          : `<span style="color:#ef4444">● 不可达</span> · 24h 可用率 ${pct}`;
      })
      .catch(() => {
        const el = document.getElementById('live-value');
        if (el) el.textContent = '暂无监测数据';
      });

    const favBtn = document.getElementById('fav-btn') as HTMLButtonElement | null;
    if (favBtn) {
      const renderFav = () => {
        const favs: string[] = JSON.parse(localStorage.getItem('tf-favs') || '[]');
        const on = favs.includes(siteId);
        favBtn.textContent = on ? '★ 已收藏' : '☆ 收藏';
        favBtn.classList.toggle('text-accent', on);
      };
      favBtn.onclick = () => {
        const favs: string[] = JSON.parse(localStorage.getItem('tf-favs') || '[]');
        const i = favs.indexOf(siteId);
        if (i >= 0) favs.splice(i, 1);
        else favs.push(siteId);
        localStorage.setItem('tf-favs', JSON.stringify(favs));
        renderFav();
      };
      renderFav();
    }

    const visit = document.getElementById('visit-btn') as HTMLAnchorElement | null;
    if (visit && visit.dataset.plainUrl && localStorage.getItem('tf-aff') === '0') {
      visit.href = visit.dataset.plainUrl;
    }
  </script>
</BaseLayout>
