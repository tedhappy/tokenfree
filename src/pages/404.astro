---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在 - TokenFree">
  <div class="min-h-screen flex items-center justify-center px-4">
    <div class="text-center">
      <p class="text-6xl font-bold text-text-muted mb-4 font-mono">404</p>
      <p class="text-text-secondary text-sm mb-8"><span data-lang="zh">页面不存在或已被移除</span><span data-lang="en">Page not found or removed</span></p>
      <a href="/" class="text-sm px-4 py-2 rounded-lg bg-accent hover:bg-accent-hover text-white transition-colors"><span data-lang="zh">返回首页</span><span data-lang="en">Back to home</span></a>
    </div>
  </div>
</BaseLayout>