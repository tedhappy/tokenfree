---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    q: '什么是 AI API 中转站？',
    a: '中转站（relay）是在你和官方 API（OpenAI、Anthropic 等）之间的转发服务：你把 base_url 指向中转站，用它的 key 调用，它再转发到官方。好处是免去外币支付和网络问题，通常价格更低（倍率 < 1）。正常官转倍率在 0.7-1.5 之间。',
  },
  {
    q: '倍率（multiplier）是什么意思？',
    a: '倍率是相对官方定价的折扣系数。0.4x 表示按官方价的 40% 计费；0.01x 即 1%。注意部分站点充值比例不是 1:1（如 1 元 = 0.1 刀），实际成本要乘上充值比例。',
  },
  {
    q: '怎么使用中转站？',
    a: '注册账号 → 在后台生成 API Key → 把客户端的 base_url 换成中转站地址。支持 OpenAI 格式的客户端（ChatBox、NextChat、各类 CLI 编程工具）都可以直接用。部分站点区分分组，注册后先看清自己所在的分组倍率。',
  },
  {
    q: '怎么避免被坑？',
    a: '① 谨慎充值，先小额试用；② 同时注册 2-3 家互为备份，避免单点故障；③ 关注站点运营时长和社区口碑（LinuxDo 等）；④ 免费额度大的新站风险也大，重要数据别走不可信渠道；⑤ 本站标注的实时状态和核验日期仅供参考。',
  },
  {
    q: '免费额度/签到送的刀是真的吗？',
    a: '多数是真的，但注意：① 部分站点送的"刀"按高倍率计费，实际能用的量很小；② 有些站需要进群/做任务才发放；③ 送的额度通常限速或限模型。看到"注册送 100 刀"先看清倍率和限制再冲。',
  },
  {
    q: '中转站会跑路吗？',
    a: '会。中转站本质是灰色生意，跑路、被封、停服都常见。本站用"实时监测"标记站点可达性，连续不可达的站点会被标注。但监测只能说明"站点能打开"，不能保证"不跑路"。原则：不充值超过你能承受损失的金额。',
  },
  {
    q: '本站的数据是怎么来的，可信吗？',
    a: '站点信息每天自动核验：可达性、API 端点状态直接探测；倍率和模型列表直接读取站点官方定价接口，与人工记录不一致时保留原值并提醒复核，不会悄悄改动。新站收录前均经人工审核。所有核验记录在站点详情页的日志中可查。数据仅供参考，不构成任何担保。',
  },
  {
    q: '本站如何收录站点？',
    a: '信息来自公开渠道整理和用户投稿，编辑审核后收录。收录不代表背书，排序和精选仅代表编辑偏好。如果你是站长想收录/删除，欢迎通过投稿页联系。',
  },
]; // EN versions for data-lang spans
const faqsEn = [
  {
    "q": "What is an AI API relay site?",
    "a": "A relay (proxy) sits between you and official APIs (OpenAI, Anthropic, etc.): you point base_url at the relay and use its key. Benefits: no foreign card needed, no network issues, and usually cheaper (multiplier < 1). Fair-priced official-forwarding relays usually sit at 0.7–1.5x."
  },
  {
    "q": "What does multiplier mean?",
    "a": "The multiplier is the discount vs official pricing: 0.4x = 40% of official price; 0.01x = 1%. Note some sites use non-1:1 top-up rates (e.g. 1 CNY = 0.1 USD) — multiply that in for real cost."
  },
  {
    "q": "How do I use a relay?",
    "a": "Register → generate an API key in the dashboard → set base_url in your client. OpenAI-compatible clients (ChatBox, NextChat, CLI coding tools) work directly. Check which group/plan your account is on — multipliers differ per group."
  },
  {
    "q": "How to avoid getting burned?",
    "a": "① Top up small, test first; ② keep 2-3 relays as backups; ③ check site age and community reputation (LinuxDo etc.); ④ big free credits on new sites = big risk; ⑤ treat live status and verified dates here as reference only."
  },
  {
    "q": "Are the free credits / check-in rewards real?",
    "a": "Mostly yes, but: ① some \"credits\" are billed at high multipliers so real value is tiny; ② some require joining groups or tasks; ③ free tiers are often rate-limited or model-limited. Read the multiplier and limits before rushing in."
  },
  {
    "q": "Do relay sites run away?",
    "a": "Yes. Relays are a gray-market business — exit scams, bans and shutdowns are common. Our live monitoring marks reachability, and consistently failing sites get flagged. But \"reachable\" never guarantees \"won't run\". Rule: never top up more than you can afford to lose."
  },
  {
    "q": "Where does the data come from? Can I trust it?",
    "a": "Every site is re-checked daily: reachability and API endpoint status are probed directly; multipliers and model lists are read from each site's own public pricing endpoint. When automated results disagree with our records, we keep the recorded value and flag it for review — nothing changes silently. New listings pass human review first, and every check leaves a record in the site's public log. All data is reference only, not a guarantee."
  },
  {
    "q": "How does this directory list sites?",
    "a": "From public sources and user submissions, reviewed by the editor. Listing is not endorsement; ordering and featuring reflect editor preference. Site owners can reach us via the submit page."
  }
];
---

<BaseLayout title="FAQ 与新手指南 - TokenFree" description="什么是 AI API 中转站、倍率怎么看、怎么防跑路 —— 新手指南">
  <Header />
  <main class="pt-16">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
      <h1 class="text-2xl font-bold mb-2"><span data-lang="zh">FAQ 与新手指南</span><span data-lang="en">FAQ &amp; Guide</span></h1>
      <p class="text-sm text-text-secondary mb-8"><span data-lang="zh">中转站是什么、怎么用、怎么不被坑。</span><span data-lang="en">What relays are, how to use them, and how not to get burned.</span></p>
      <div class="space-y-3">
        {faqs.map((f, i) => (
          <details class="group rounded-xl bg-bg-secondary border border-border" open={i === 0}>
            <summary class="px-5 py-4 cursor-pointer text-sm font-medium list-none flex items-center justify-between gap-2">
              <span><span data-lang="zh">{f.q}</span><span data-lang="en">{faqsEn[i].q}</span></span>
              <svg class="w-4 h-4 text-text-muted shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <p class="px-5 pb-4 text-base text-text-secondary leading-relaxed"><span data-lang="zh">{f.a}</span><span data-lang="en">{faqsEn[i].a}</span></p>
          </details>
        ))}
      </div>
    </div>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    name: 'AI 中转站 FAQ 与新手指南',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })} />
</BaseLayout>
