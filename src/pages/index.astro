---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SiteList from '../components/SiteList';
import Footer from '../components/Footer.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import AnnounceModal from '../components/AnnounceModal.astro';
import { getFilteredSites } from '../utils/sites';
import modelsJson from '../data/models.json';

const allSites = await getFilteredSites();
const featuredSites = allSites.filter((s) => s.isFeatured && s.url);
const models = modelsJson as any;
const siteCount = allSites.length;
const stableCount = allSites.filter((s) => s.status === 'stable').length;
---

<BaseLayout>
  <Header />
  <main class="pt-14">
    <AnnouncementBar />
    <Hero siteCount={siteCount} stableCount={stableCount} />
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-20">
      <section id="sites" class="scroll-mt-20">
        <h2 class="text-lg font-medium text-text-primary mb-4 flex items-center gap-2">
          <span class="w-1 h-4 bg-accent rounded-full"></span>
          <span data-lang="zh">全部站点</span><span data-lang="en">All Sites</span>
        </h2>
        <SiteList client:load initialSites={allSites} models={models} />
      </section>
    </div>
  </main>
  <AnnounceModal />
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'TokenFree AI Token 中转站导航',
    description: '收录可用、稳定的 AI API 中转站，实时监测，倍率对比',
    numberOfItems: siteCount,
    itemListElement: featuredSites.slice(0, 10).map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.name,
      url: new URL(`/site/${s.id}`, Astro.site ?? 'https://www.tokenfree.wiki').href,
    })),
  })} />
</BaseLayout>
