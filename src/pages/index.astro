---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SiteList from '../components/SiteList';
import Footer from '../components/Footer.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import { getFilteredSites, goUrl } from '../utils/sites';
import modelsJson from '../data/models.json';

const allSites = await getFilteredSites();
const featuredSites = allSites.filter((s) => s.isFeatured && s.url);
const models = modelsJson as any;
const siteCount = allSites.length;
const stableCount = allSites.filter((s) => s.status === 'stable').length;
---

<BaseLayout>
  <Header />
  <main class="pt-14">
    <AnnouncementBar />
    <Hero siteCount={siteCount} stableCount={stableCount} />
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-20">
      {featuredSites.length > 0 && (
        <section class="mb-12">
          <h2 class="text-lg font-medium text-text-secondary mb-5 flex items-center gap-2" data-i18n-group="featured">
            <span class="w-1 h-4 bg-accent rounded-full"></span>
            <span data-i18n="section.featured">编辑精选</span>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {featuredSites.map((site) => {
              const m0 = models.find((mm: any) => mm.id === site.models[0]);
              return (
                <div class="group p-5 rounded-xl bg-bg-secondary border border-border hover:border-border-hover transition-colors">
                  <div class="flex items-start justify-between gap-3 mb-3">
                    <a href={`/site/${site.id}`} class="font-medium text-text-primary group-hover:text-accent transition-colors truncate">
                      {site.name}
                    </a>
                    {site.multiplier !== null && (
                      <span class="text-xs font-mono text-text-muted shrink-0 ml-3">{site.multiplier}x</span>
                    )}
                  </div>
                  <p class="text-sm text-text-secondary line-clamp-2 leading-relaxed">{site.summary}</p>
                  <div class="flex items-center justify-between mt-3">
                    <div class="flex flex-wrap gap-1.5 min-w-0">
                      {site.models.slice(0, 3).map((mid) => {
                        const model = models.find((mm: any) => mm.id === mid);
                        if (!model) return null;
                        return (
                          <span class="text-xs px-2 py-0.5 rounded-full border" style={`border-color: ${model.color}30; color: ${model.color}`}>
                            {model.name}
                          </span>
                        );
                      })}
                    </div>
                    <a
                      href={goUrl(site)}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="shrink-0 text-xs px-3 py-1.5 rounded-lg bg-accent-muted text-accent hover:bg-accent hover:text-white transition-colors ml-2"
                    >访问 →</a>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      )}
      <section>
        <h2 class="text-lg font-medium text-text-secondary mb-5 flex items-center gap-2">
          <span class="w-1 h-4 bg-text-muted rounded-full"></span>
          <span data-i18n="section.all">全部站点</span>
        </h2>
        <SiteList client:load initialSites={allSites} models={models} />
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
