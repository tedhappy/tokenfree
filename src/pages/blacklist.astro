---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getAllSites } from '../utils/sites';

const all = await getAllSites();
const offline = all.filter((s) => s.status === 'offline');
const unstable = all.filter((s) => s.status === 'unstable');
---

<BaseLayout title="避雷榜 - TokenFree" description="已失效、疑似跑路和状态不稳定的中转站名单">
  <Header />
  <main class="pt-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
      <h1 class="text-2xl font-bold mb-2">⚠ 避雷榜</h1>
      <p class="text-sm text-text-secondary mb-4">以下站点已失效、疑似跑路或状态不稳定。数据来自编辑核验与自动监测，仅供参考。</p>
      <p class="text-xs text-text-muted mb-10">提示：在这些站有余额的用户建议尽快用完；未注册的不建议充值。</p>

      {offline.length > 0 && (
        <section class="mb-10">
          <h2 class="text-sm font-medium text-status-offline mb-4">已失效 / 跑路（{offline.length}）</h2>
          <div class="space-y-3">
            {offline.map((s) => (
              <div class="p-4 rounded-xl bg-bg-secondary border border-status-offline/20">
                <div class="flex items-center justify-between gap-3 mb-1">
                  <span class="font-medium text-text-primary">{s.name}</span>
                  <span class="text-xs text-text-muted font-mono">{s.verifiedAt}</span>
                </div>
                <p class="text-sm text-text-secondary">{s.summary}</p>
                {s.description && <p class="text-xs text-text-muted mt-1.5 leading-relaxed">{s.description}</p>}
              </div>
            ))}
          </div>
        </section>
      )}

      {unstable.length > 0 && (
        <section class="mb-10">
          <h2 class="text-sm font-medium text-status-unstable mb-4">状态不稳定（{unstable.length}）</h2>
          <div class="space-y-3">
            {unstable.map((s) => (
              <div class="p-4 rounded-xl bg-bg-secondary border border-status-unstable/20">
                <div class="flex items-center justify-between gap-3 mb-1">
                  <a href={`/site/${s.id}`} class="font-medium text-text-primary hover:text-accent transition-colors">{s.name}</a>
                  <span class="text-xs text-text-muted font-mono">{s.verifiedAt}</span>
                </div>
                <p class="text-sm text-text-secondary">{s.summary}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <div id="monitor-down" class="hidden">
        <h2 class="text-sm font-medium text-status-unstable mb-4">监测中不可达</h2>
        <p class="text-xs text-text-muted">以下站点当前自动监测不可达（可能临时故障或已关闭），持续不可达会被编辑标记：</p>
        <div id="monitor-down-list" class="flex flex-wrap gap-2 mt-3"></div>
      </div>
    </div>
  </main>
  <Footer />
  <script>
    fetch('/api/uptime')
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!d) return;
        const down = Object.entries(d).filter(([, v]: any) => v.checks > 0 && !v.up && v.checks >= 3);
        if (!down.length) return;
        document.getElementById('monitor-down')?.classList.remove('hidden');
        const list = document.getElementById('monitor-down-list')!;
        list.innerHTML = down
          .map(([id]) => `<a href="/site/${id}" class="text-xs px-2.5 py-1 rounded-full border border-status-unstable/30 text-status-unstable hover:border-status-unstable transition-colors">${id}</a>`)
          .join('');
      })
      .catch(() => {});
  </script>
</BaseLayout>
