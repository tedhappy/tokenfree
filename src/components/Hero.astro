---
import config from '../data/config.json';
import { fetchUptime } from '../utils/clientData';
interface Props {
  siteCount: number;
  stableCount: number;
}
const { siteCount, stableCount } = Astro.props;
// 首页文案后台可配（config.json hero 字段，改后需重建前台）；未配置时用默认文案
const hero = (config as any).hero || {};
const title = hero.title || 'AI Token 中转站精选榜';
const titleEn = hero.titleEn || 'The Best AI Token Relays';
const sub = hero.sub || '让每个人都能免费用 Token，实现 Token 自由';
const subEn = hero.subEn || 'Free tokens for everyone — your token freedom starts here.';
const sub2 = hero.sub2 || '编辑实测筛选的可用中转站：免费额度 · 低价倍率 · 实时监测，一站看清';
const sub2En = hero.sub2En || 'Editor-tested AI API relays: free credits · low multipliers · live monitoring, all at a glance.';
---

<section class="pt-16 pb-10 sm:pt-20 sm:pb-14">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 text-center">
    <h1 class="text-3xl sm:text-5xl font-bold tracking-tight mb-4">
      <span class="bg-clip-text text-transparent" style="background-image: linear-gradient(120deg, var(--c-t1) 30%, var(--c-accent));">
        <span data-lang="zh">{title}</span><span data-lang="en">{titleEn}</span>
      </span>
    </h1>
    <p class="text-text-secondary text-sm sm:text-base max-w-xl mx-auto mb-2">
      <span data-lang="zh">{sub}</span><span data-lang="en">{subEn}</span>
    </p>
    <p class="text-text-muted text-xs sm:text-sm max-w-xl mx-auto mb-8">
      <span data-lang="zh">{sub2}</span><span data-lang="en">{sub2En}</span>
    </p>
    <div class="flex justify-center flex-wrap gap-3 mb-8">
      <a
        href="/recommend"
        class="inline-flex items-center gap-2 text-sm px-5 py-2.5 rounded-xl bg-accent hover:bg-accent-hover text-white font-medium shadow-lg shadow-accent/20 transition-all hover:-translate-y-0.5"
      >
        <span data-lang="zh">不知道选哪个？30 秒帮我选站</span><span data-lang="en">Not sure? Find my match in 30s</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
      <span class="text-xs sm:text-sm px-3 py-1.5 rounded-full bg-status-stable/10 text-status-stable border border-status-stable/20 flex items-center gap-1">
        <span class="font-bold text-lg leading-none">{siteCount}</span> <span data-i18n="hero.sites">个站点</span>
      </span>
      <span class="text-xs sm:text-sm px-3 py-1.5 rounded-full bg-accent-muted text-accent border border-accent/20 flex items-center gap-1">
        <span class="font-bold text-lg leading-none">{stableCount}</span> <span data-i18n="hero.stable">个稳定</span>
      </span>
      <span class="text-xs sm:text-sm px-3 py-1.5 rounded-full bg-bg-secondary text-text-secondary border border-border flex items-center gap-1" title="全站近 24 小时可用率均值（自动监测）">
        <span data-i18n="hero.live">实时在线</span> <span id="hero-health" class="font-bold text-lg leading-none text-text-primary">…</span>
      </span>
    </div>
  </div>
</section>

<script>
  // 全站健康度：24h 可用率均值（比瞬时探测更稳，避免单站抖动导致数字跳动）
  fetchUptime()
    .then((d) => {
      const el = document.getElementById('hero-health');
      if (!el) return;
      const entries = Object.values(d || {});
      const withData = entries.filter((e: any) => e.checks > 0 && e.uptime24h != null);
      if (!withData.length) {
        el.textContent = '—';
        return;
      }
      const pct = Math.round((withData.reduce((s: number, e: any) => s + e.uptime24h, 0) / withData.length) * 100);
      el.textContent = `${pct}%`;
      el.style.color = pct >= 80 ? '#22c55e' : pct >= 50 ? '#f59e0b' : '#ef4444';
    })
    .catch(() => {
      const el = document.getElementById('hero-health');
      if (el) el.textContent = '—';
    });
</script>
