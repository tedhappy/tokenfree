---
interface Props {
  siteCount: number;
  stableCount: number;
}
const { siteCount, stableCount } = Astro.props;
---

<section class="pt-16 pb-10 sm:pt-20 sm:pb-14">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
    <h1 class="text-3xl sm:text-5xl font-bold tracking-tight mb-4" data-i18n="hero.title">
      <span class="bg-clip-text text-transparent" style="background-image: linear-gradient(120deg, var(--c-t1) 30%, var(--c-accent));">
        AI Token 中转站导航
      </span>
    </h1>
    <p class="text-text-secondary text-sm sm:text-base max-w-lg mx-auto mb-8" data-i18n="hero.sub">
      收录可用、稳定的 AI API 中转站，帮你快速找到免费额度和低价倍率入口
    </p>
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
      <span class="text-xs sm:text-sm px-3 py-1.5 rounded-full bg-status-stable/10 text-status-stable border border-status-stable/20">
        <span class="font-semibold">{siteCount}</span> 个站点
      </span>
      <span class="text-xs sm:text-sm px-3 py-1.5 rounded-full bg-accent-muted text-accent border border-accent/20">
        <span class="font-semibold">{stableCount}</span> 个稳定
      </span>
      <span class="text-xs sm:text-sm px-3 py-1.5 rounded-full bg-bg-secondary text-text-secondary border border-border">
        实时在线 <span id="hero-health" class="font-semibold text-text-primary">…</span>
      </span>
    </div>
  </div>
</section>

<script>
  // 全站健康度：聚合监测 API
  fetch('/api/uptime')
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => {
      const el = document.getElementById('hero-health');
      if (!el) return;
      const entries = Object.values(d || {});
      const checked = entries.filter((e: any) => e.checks > 0);
      if (!checked.length) {
        el.textContent = '—';
        return;
      }
      const up = checked.filter((e: any) => e.up).length;
      const pct = Math.round((up / checked.length) * 100);
      el.textContent = `${pct}%`;
      el.style.color = pct >= 80 ? '#22c55e' : pct >= 50 ? '#f59e0b' : '#ef4444';
    })
    .catch(() => {
      const el = document.getElementById('hero-health');
      if (el) el.textContent = '—';
    });
</script>
