---
import config from '../data/config.json';
const { qq } = config as { qq?: string };
const footer = (config as any).footer || {};
const disclaimer = footer.disclaimer || '仅供参考，不对任何中转站的安全性负责。';
const disclaimerEn = footer.disclaimerEn || 'For reference only. We are not responsible for any relay site.';
const aff = footer.aff || '部分注册链接含本站推广码，不影响你获得的额度与体验。';
const affEn = footer.affEn || 'Some sign-up links contain our referral code — it never affects the credits or experience you get.';
const year = new Date().getFullYear();
// 兼容三种格式：完整链接 / k= 参数 / q/ 短码
const qqHref = !qq
  ? ''
  : /^https?:\/\//.test(qq)
    ? qq
    : qq.startsWith('q/')
      ? `https://qm.qq.com/${qq}`
      : `https://qm.qq.com/cgi-bin/qm/qr?k=${qq}`;
---

<footer class="border-t border-border py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col items-center gap-3 text-xs text-text-muted">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 w-full">
      <p data-i18n="footer.disclaimer">&copy; {year} TokenFree. <span data-lang="zh">{disclaimer}</span><span data-lang="en">{disclaimerEn}</span></p>
      <div class="flex items-center gap-4 flex-wrap justify-center">
        {qq && <a href={qqHref} target="_blank" rel="noopener noreferrer" class="hover:text-text-secondary transition-colors">QQ群</a>}
        <a href="/submit" class="hover:text-text-secondary transition-colors" data-i18n="nav.submit">投稿</a>
        <a href="/recommend" class="hover:text-text-secondary transition-colors" data-i18n="nav.recommend">选站</a>
        <a href="/faq" class="hover:text-text-secondary transition-colors" data-i18n="nav.faq">FAQ</a>
        <a href="/about" class="hover:text-text-secondary transition-colors" data-i18n="footer.about">关于</a>
        <a href="/admin" class="hover:text-text-secondary transition-colors" data-i18n="footer.admin">管理</a>
      </div>
    </div>
    <p class="text-center" data-i18n="footer.aff"><span data-lang="zh">{aff}</span><span data-lang="en">{affEn}</span></p>
  </div>
</footer>
