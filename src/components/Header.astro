---
import { getSiteCount } from '../utils/sites';
const siteCount = await getSiteCount();
---

<header class="fixed top-0 left-0 right-0 z-50 bg-bg/80 backdrop-blur-md border-b border-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-2">
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
        <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
      </svg>
      <span class="font-semibold text-sm tracking-tight">TokenFree</span>
      <span class="text-xs text-text-muted font-mono">{siteCount}</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <nav class="flex items-center gap-1 sm:gap-4">
        <a href="/" class="text-sm text-text-secondary hover:text-text-primary transition-colors px-1" data-i18n="nav.home">首页</a>
        <a href="/submit" class="text-sm text-text-secondary hover:text-text-primary transition-colors px-1" data-i18n="nav.submit">投稿</a>
        <a href="/faq" class="text-sm text-text-secondary hover:text-text-primary transition-colors px-1 hidden xs:inline sm:inline" data-i18n="nav.faq">FAQ</a>
        <a href="/about" class="text-sm text-text-secondary hover:text-text-primary transition-colors px-1" data-i18n="nav.about">关于</a>
      </nav>
      <span class="w-px h-4 bg-border"></span>
      <button id="lang-toggle" class="text-xs text-text-muted hover:text-text-primary transition-colors" title="Language">EN</button>
      <button id="theme-toggle" class="text-text-muted hover:text-text-primary transition-colors" title="Theme">
        <svg id="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg id="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72 1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  function syncThemeIcons() {
    const light = document.documentElement.classList.contains('light');
    document.getElementById('icon-moon')?.classList.toggle('hidden', light);
    document.getElementById('icon-sun')?.classList.toggle('hidden', !light);
  }
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light');
    localStorage.setItem('tf-theme', isLight ? 'light' : 'dark');
    syncThemeIcons();
  });
  syncThemeIcons();

  const langBtn = document.getElementById('lang-toggle');
  const setLabel = () => {
    if (langBtn) langBtn.textContent = localStorage.getItem('tf-lang') === 'en' ? '中文' : 'EN';
  };
  langBtn?.addEventListener('click', () => {
    const cur = localStorage.getItem('tf-lang');
    localStorage.setItem('tf-lang', cur === 'en' ? 'zh' : 'en');
    location.reload();
  });
  setLabel();
</script>
