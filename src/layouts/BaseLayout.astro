---
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'TokenFree - AI Token 中转站导航',
  description = '收集 AI Token 公益中转站，帮助更多人找到可用、稳定、低门槛的 AI 服务入口。',
} = Astro.props;
const ogImage = new URL('/og.png', Astro.site ?? 'https://www.tokenfree.wiki').href;
// canonical：统一域名避免重复内容（/go 带 query 参数不设）
const canonical =
  Astro.url.pathname === '/go/'
    ? null
    : new URL(Astro.url.pathname, Astro.site ?? 'https://www.tokenfree.wiki').href;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    {canonical && <link rel="canonical" href={canonical} />}
    <script is:inline src="/js/i18n.js"></script>
    <script is:inline>
      // 主题/语言初始化：必须在 head 内首屏渲染前执行，避免页面闪跳
      (function () {
        var d = document.documentElement;
        if (localStorage.getItem('tf-theme') === 'dark') d.classList.add('dark');
        var en = localStorage.getItem('tf-lang') === 'en';
        d.classList.add(en ? 'lang-en' : 'lang-zh');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'TokenFree',
      description,
      url: Astro.site?.toString() ?? 'https://www.tokenfree.wiki',
    })} />
  </head>
  <body class="bg-bg text-text-primary min-h-screen font-sans antialiased">
    <!-- 顶部品牌光晕（极淡，氛围用） -->
    <div class="pointer-events-none fixed inset-x-0 top-0 h-[420px] overflow-hidden z-0" aria-hidden="true">
      <div class="absolute left-1/2 -translate-x-1/2 -top-[220px] w-[820px] h-[480px] rounded-full opacity-[0.13]" style="background: radial-gradient(ellipse at center, var(--c-accent), transparent 65%);"></div>
    </div>
    <div class="relative z-10">
      <slot />
    </div>
    <script is:inline>
      // 文案翻译：DOM 就绪后替换 data-i18n 文本（语言类已在 head 设置，双语块不会闪）
      (function () {
        if (document.documentElement.classList.contains('lang-en')) {
          var dict = window.TF_I18N_EN || {};
          document.querySelectorAll('[data-i18n]').forEach(function (el) {
            var key = el.getAttribute('data-i18n');
            if (dict[key]) el.textContent = dict[key];
          });
          document.documentElement.lang = 'en';
        }
      })();
    </script>
  </body>
</html>
