---
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'TokenFree - AI Token 中转站导航',
  description = '收集 AI Token 公益中转站，帮助更多人找到可用、稳定、低门槛的 AI 服务入口。',
} = Astro.props;
const ogImage = new URL('/og.png', Astro.site ?? 'https://tokenfree.example.com').href;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/js/i18n.js"></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'TokenFree',
      description,
      url: Astro.site?.toString() ?? 'https://tokenfree.example.com',
    })} />
  </head>
  <body class="bg-bg text-text-primary min-h-screen font-sans antialiased">
    <!-- 顶部品牌光晕（极淡，氛围用） -->
    <div class="pointer-events-none fixed inset-x-0 top-0 h-[420px] overflow-hidden z-0" aria-hidden="true">
      <div class="absolute left-1/2 -translate-x-1/2 -top-[220px] w-[820px] h-[480px] rounded-full opacity-[0.13]" style="background: radial-gradient(ellipse at center, var(--c-accent), transparent 65%);"></div>
    </div>
    <div class="relative z-10">
      <slot />
    </div>
    <script>
      // 主题初始化：默认浅色，localStorage 记忆切换（在渲染前执行避免闪烁）
      // 兼容旧存储值：旧方案存的 'dark'/'light' 与新方案语义一致
      (function () {
        if (localStorage.getItem('tf-theme') === 'dark') document.documentElement.classList.add('dark');
      })();
      // 轻量 i18n：data-i18n 元素替换文本 + html 语言类控制 [data-lang] 双语内容显隐
      (function () {
        const en = localStorage.getItem('tf-lang') === 'en';
        document.documentElement.classList.add(en ? 'lang-en' : 'lang-zh');
        if (!en) return;
        const dict = window.TF_I18N_EN || {};
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (dict[key]) el.textContent = dict[key];
        });
        document.documentElement.lang = 'en';
      })();
    </script>
  </body>
</html>
